{
  "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
  "tasks.max": "1",
  "database.hostname": "postgres",
  "database.port": "5432",
  "database.user": "postgres",
  "database.password": "postgres",
  "database.dbname": "ecommerce",
  "topic.prefix": "postgres",
  "plugin.name": "pgoutput",
  "slot.name": "ecommerce_cdc_slot",
  "publication.name": "ecommerce_cdc_publication",
  "publication.autocreate.mode": "filtered",
  "schema.include.list": "public",
  "table.include.list": "public.customers,public.products,public.orders,public.order_items,public.payments",
  "snapshot.mode": "initial",
  "decimal.handling.mode": "string",
  "time.precision.mode": "connect",
  "tombstones.on.delete": "false",
  "include.schema.changes": "false",
  "transforms": "route",
  "transforms.route.type": "io.debezium.transforms.ByLogicalTableRouter",
  "transforms.route.topic.regex": "postgres\\.public\\.(.*)",
  "transforms.route.topic.replacement": "postgres.$1",
  "transforms.route.key.enforce.uniqueness": "false"
}
