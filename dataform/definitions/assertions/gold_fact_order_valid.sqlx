config {
  type: "assertion",
  tags: ["gold", "fact"]
}

SELECT
  order_id
FROM
  ${ref("fact_order")}
GROUP BY
  order_id
HAVING
  COUNT(*) > 1

UNION ALL

SELECT
  order_id
FROM
  ${ref("fact_order")}
WHERE
  order_sk IS NULL
  OR customer_sk IS NULL
  OR order_date_key IS NULL
  OR order_total < 0
