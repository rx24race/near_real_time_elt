config {
  type: "table",
  schema: dataform.projectConfig.vars.silverDataset,
  name: "payments",
  tags: ["silver", "current_state"]
}

WITH source_events AS (
  SELECT
    SAFE_CAST(JSON_VALUE(COALESCE(after_json, before_json), "$.payment_id") AS INT64) AS payment_id,
    op,
    event_ts,
    kafka_partition,
    kafka_offset,
    ingested_at,
    after_json
  FROM
    ${ref("cdc_events")}
  WHERE
    source_table = "payments"
),

latest_events AS (
  SELECT
    *
  FROM
    source_events
  WHERE
    payment_id IS NOT NULL
  QUALIFY
    ROW_NUMBER() OVER (
      PARTITION BY payment_id
      ORDER BY event_ts DESC NULLS LAST, ingested_at DESC, kafka_partition DESC, kafka_offset DESC
    ) = 1
)

SELECT
  payment_id,
  SAFE_CAST(JSON_VALUE(after_json, "$.order_id") AS INT64) AS order_id,
  JSON_VALUE(after_json, "$.payment_method") AS payment_method,
  JSON_VALUE(after_json, "$.payment_status") AS payment_status,
  SAFE_CAST(JSON_VALUE(after_json, "$.amount") AS NUMERIC) AS amount,
  TIMESTAMP(JSON_VALUE(after_json, "$.created_at")) AS created_at,
  TIMESTAMP(JSON_VALUE(after_json, "$.updated_at")) AS updated_at,
  event_ts AS cdc_event_ts,
  ingested_at AS bronze_ingested_at,
  kafka_partition,
  kafka_offset
FROM
  latest_events
WHERE
  op != "d"
