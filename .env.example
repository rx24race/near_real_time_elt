# Copy this file to .env and adjust values for your local environment.

POSTGRES_DB=ecommerce
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

KAFKA_BROKER_ID=1
KAFKA_PORT=9092
KAFKA_CONNECT_PORT=8083
KAFKA_UI_PORT=8081
KAFKA_CONSUMER_GROUP=cdc-bq-bronze-loader
KAFKA_TOPICS=postgres.customers,postgres.products,postgres.orders,postgres.order_items,postgres.payments
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_MAX_POLL_RECORDS=100
KAFKA_POLL_TIMEOUT_MS=5000

AIRFLOW_UID=50000
AIRFLOW_PORT=8080
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin

GCP_PROJECT_ID=near-real-time-elt
BIGQUERY_BRONZE_DATASET=bronze
BIGQUERY_BRONZE_TABLE=cdc_events
BIGQUERY_LOCATION=US
BIGQUERY_MAX_RETRIES=3
BIGQUERY_RETRY_BACKOFF_SECONDS=5
GOOGLE_APPLICATION_CREDENTIALS=/opt/app/credentials/service_account.json
